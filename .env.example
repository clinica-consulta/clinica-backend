# Porta da API
PORT=3000

# Conexão com o MongoDB
# Local:  mongodb://127.0.0.1:27017/gestao-consultas
# Atlas:  mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/gestao-consultas?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-consultas

# Segredo usado para assinar o token de login (troque por um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=8h

# Endereço do front-end liberado no CORS (separe vários por vírgula). Vazio libera todos.
CORS_ORIGIN=http://localhost:8080

# Senha inicial dos usuários criados pela recepção/administração e pelo seed
SENHA_PADRAO=123456
